# Copy to ~/.egma-livekit.env (kept out of the repo), fill in, then:
#   set -a; source ~/.egma-livekit.env; set +a
#
# ./calendar-is-full.sh reads this file for you. If your values are split
# across several files, name them all:
#   EGMA_LIVEKIT_ENV=~/.egma-livekit.env:~/.egma-voice.env ./calendar-is-full.sh

# Your LiveKit project — dashboard at cloud.livekit.io, or ws://localhost:7880 for `livekit-server --dev`.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# One key runs the agent's ears, brain and mouth — and, in the live suites,
# the persona's brain too.
OPENAI_API_KEY=

# Blank = unnamed worker = automatic dispatch (joins every new room).
# Set a name (e.g. front-desk) to test explicit dispatch instead.
EGMA_DUMB_AGENT_NAME=

# The persona's own speech — egma's side, not this agent's, and needed only
# by the live suites that simulate against this worker. Leave them blank and
# those suites skip and say which one is missing.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
