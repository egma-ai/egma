# Copy to .env beside bot.py (kept out of the repo) for local runs. The bot
# reads it on start; the development runner reads DAILY_API_KEY from it too.

# The bot's own services, as in Pipecat's generated quickstart.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Local runs only: the development runner creates a Daily room with this key
# for every start request. Pipecat Cloud makes its own rooms and needs none.
DAILY_API_KEY=

# Egma, when the bot runs with the SDK. Hosted: https://app.egma.ai
EGMA_URL=
EGMA_API_KEY=

# Optional defaults for every session; runner_args.body["e2e"] wins.
# E2E_VARIANT=plain       # plain | flows
# E2E_RTVI=on             # on | off
# EGMA_SDK=auto           # auto | on | off
# EGMA_MONITOR=off        # on | off
# E2E_SKIP_TTS=off        # on | off

# tools/rtvi_client.py pcc: the Pipecat Cloud public key (pk_...).
EGMA_PIPECAT_PUBLIC_KEY=
