{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "baseUrl": ".",
    "paths": {
      "@egma/ids": ["./packages/ids/src/index.ts"],
      "@egma/db": ["./packages/db/src/index.ts"],
      "@egma/simulation-contract": [
        "./packages/simulation-contract/src/index.ts"
      ]
    }
  },
  "include": [
    "vitest.config.ts",
    "packages/*/src/**/*.test.ts",
    "packages/*/test/**/*.ts",
    "apps/api/test/**/*.ts",
    "apps/grader/test/**/*.ts",
    "apps/cli/test/**/*.ts",
    "apps/cli/smoke/**/*.ts"
  ],
  "exclude": [
    // A committed fixture repository is another project's source, kept as it
    // would really be written. It is read by tests, never compiled with them.
    "apps/cli/test/fixtures/**"
  ]
}
