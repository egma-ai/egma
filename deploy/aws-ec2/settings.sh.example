#!/bin/bash
# Write the `.env` a deployment runs on, and write it fresh every time.
#
# Copy this to `settings.sh` beside `deploy.sh` and fill it in. **Your copy is
# not in this repository and must not be** — not because it holds secrets (it
# should hold none; every value below is fetched at run time) but because it
# holds *your* answers: which database, which bucket, which address. Two
# deployments of egma differ here and nowhere else.
#
# **No secret value is written into this file.** Each is fetched from a secret
# store at deployment time, so the only thing on disk is the name of a secret.
# The example uses AWS Secrets Manager because the machine already holds a
# credential for it through its instance role; any store works the same way.
#
# The `.env` it writes is read by `docker-compose.yml` together with
# `docker-compose.managed.yml`, which switches off the containers a deployment
# using managed services does not run.
set -euo pipefail

REGION="${AWS_REGION:-us-east-1}"
get() { aws secretsmanager get-secret-value --secret-id "$1" --region "$REGION" --query SecretString --output text; }
j()   { python3 -c "import json,sys;print(json.loads(sys.argv[1])[sys.argv[2]])" "$1" "$2"; }

DB=$(get egma/db/postgres)
CH=$(get egma/clickhouse)
P=$(get egma/platform/secrets)

# 077 so the file is created readable by this user and nobody else. It carries
# every credential the platform runs on, in plain text, for as long as the
# deployment lives.
umask 077
cat > "$(dirname "${BASH_SOURCE[0]}")/.env" <<ENV
# --- The two stores that used to be containers -----------------------------
# Whole URLs. Setting them is what makes the bundled postgres and clickhouse
# unnecessary; leaving them unset points egma back at its own containers.
DATABASE_URL=$(j "$DB" url)
CLICKHOUSE_URL=$(j "$CH" url)

# --- What this instance is ------------------------------------------------
# The address people really type. Every link egma sends — an invitation, a
# password reset, a run's results — is built from it, and the CLI refuses a
# platform that names an origin other than the one it was asked at.
EGMA_BASE_URL=https://egma.example
# On behind a load balancer or a tunnel that terminates TLS. Off is right for a
# self-host and wrong here.
EGMA_TRUST_PROXY=true
# Off for a platform that many organizations sign up to; the default of true
# closes sign-up once the first one claims the deployment.
EGMA_SINGLE_ORGANIZATION=false

# --- Secrets, by name ------------------------------------------------------
EGMA_AUTH_SECRET=$(j "$P" EGMA_AUTH_SECRET)
# Seals every stored connection credential. It cannot be rotated in place, and
# a store is not a backup: keep a second copy somewhere else entirely.
EGMA_ENCRYPTION_KEY=$(j "$P" EGMA_ENCRYPTION_KEY)
EGMA_SIMULATOR_SERVICE_TOKEN=$(j "$P" EGMA_SIMULATOR_SERVICE_TOKEN)
ENV

echo "settings written: $(grep -c = "$(dirname "${BASH_SOURCE[0]}")/.env") values"

# What else belongs here, and is left out of this example because every
# deployment answers it differently:
#
#   the object store        EGMA_BLOB_* and EGMA_SIMULATOR_S3_*
#   the media bridge        EGMA_SIMULATOR_LIVEKIT_*
#   mail                    EGMA_SMTP_URL, EGMA_MAIL_FROM
#   the judge and persona   EGMA_JUDGE_*, EGMA_SIMULATOR_MODEL_*
#   the carrier             EGMA_PHONE_*, EGMA_SIMULATOR_SIP_TRUNK_*
#
# `.env.example` at the repository root documents each of them in full.
