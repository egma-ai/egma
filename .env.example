# Copy this file to .env in the Egma platform workspace.
#
# This file contains only values that the self-host operator gets from an
# external service. `egma self-host up` generates Egma's internal auth,
# encryption, LiveKit, and bundled MinIO credentials.
#
# Add only the model providers selected by your personas or graders.
# The shipped default uses OpenAI and Cartesia.
EGMA_OPENAI_API_KEY=
EGMA_CARTESIA_API_KEY=

# Optional: add this only when a persona uses Deepgram speech-to-text.
EGMA_DEEPGRAM_API_KEY=

# Optional phone calls through a carrier such as Twilio.
#
# The trunk address is the termination SIP URI hostname, without `sip://` or a
# path. The source number is the Twilio number attached to that trunk, in E.164.
EGMA_PHONE_TRUNK_ADDRESS=
EGMA_PHONE_SOURCE_NUMBER=

# For SIP credential authentication, use a username and password from the
# credential list attached to the trunk. These are NOT the Twilio Account SID
# and Auth Token. Leave both blank only when the carrier authenticates by source
# IP. Wrap any credential containing `$` in single quotes so Compose keeps it
# literal.
EGMA_PHONE_TRUNK_USERNAME=
EGMA_PHONE_TRUNK_PASSWORD=

# An empty route preserves sealed phone settings from an older Egma release.
# To remove that retained route deliberately, uncomment this line:
# EGMA_PHONE_DISABLED=true
