# Copy this file to .env in the Egma platform workspace.

# Add api keys for model providers selected by your personas or graders.
# The shipped defaults uses OpenAI and Cartesia.
EGMA_OPENAI_API_KEY=
EGMA_CARTESIA_API_KEY=

# Optional: add this if a persona uses Deepgram speech-to-text.
EGMA_DEEPGRAM_API_KEY=

# Optional: hold excess voice simulations in the queue. The first value caps
# all voice simulations; the second maps speech provider names to their caps.
# Leave both empty for the default uncapped self-hosted behavior.
EGMA_VOICE_SIMULATION_CONCURRENCY_CAP=
EGMA_SPEECH_PROVIDER_CONCURRENCY_CAPS=

# for phone simulations through a carrier such as Twilio. Set all four values to dial
EGMA_PHONE_TRUNK_ADDRESS=your-trunk.pstn.twilio.com
EGMA_PHONE_SOURCE_NUMBER=number_in_E.164_format
EGMA_PHONE_TRUNK_USERNAME=sip_user_name
EGMA_PHONE_TRUNK_PASSWORD=sip_password

# Optional: billing. Setting a Stripe secret key turns on plans, monthly
# allowances and a prepaid inference balance for every organization on this
# deployment. Leave it empty unless you charge the people who use it — Egma
# measures and shows what every simulation costs either way.
EGMA_STRIPE_SECRET_KEY=
# The signing secret of the Stripe webhook endpoint you point at
# /api/billing/stripe/webhook. Without it Egma mounts no endpoint at all: a
# signature is a delivery's only credential.
EGMA_STRIPE_WEBHOOK_SECRET=
# Stripe's publishable key. Public by design, and nothing reads it yet.
