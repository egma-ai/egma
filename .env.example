# Copy this file to .env. Ports and the stores' own users have working defaults
# in docker-compose.yml, and each process owns the default for its per-container
# tuning. You can leave those alone — but **twelve variables have no default
# anywhere and the deployment refuses to start without them**, naming the one
# it is missing.
#
# They are this deployment's own secrets and its own address, and each one is
# marked REQUIRED below. A default for any of them would be a value every
# reader of this repository holds: the key that seals stored credentials, the
# secret that signs your sessions, the token that hands a claim answer your
# customers' live credentials, the credential that can replace any recording
# you hold. A platform running on those looks perfectly healthy, which is why
# it is refused instead.
#
#   EGMA_ENCRYPTION_KEY  EGMA_AUTH_SECRET  EGMA_SIMULATOR_SERVICE_TOKEN
#   EGMA_S3_ACCESS_KEY_ID  EGMA_S3_SECRET_ACCESS_KEY
#   EGMA_S3_READ_ACCESS_KEY_ID  EGMA_S3_READ_SECRET_ACCESS_KEY
#   EGMA_S3_INGEST_ACCESS_KEY_ID  EGMA_S3_INGEST_SECRET_ACCESS_KEY
#   EGMA_BASE_URL
#   EGMA_LIVEKIT_API_KEY  EGMA_LIVEKIT_API_SECRET
#
# The last three of those you do not type. `egma self-host up` generates the
# media pair for your workspace, writes it where the deployment reads it back,
# and sets EGMA_BASE_URL to the address it prints — so a workspace started
# through the CLI needs the first nine here and nothing more.

# Postgres. The published port is 5433 so it does not collide with a Postgres
# already running on the machine.
#
# **The bind is loopback by default and that is a security decision.** The user
# and password just below are printed in this repository, and what answers on
# this port is every row your platform holds — your organizations, your keys,
# and the settings it seals. On 0.0.0.0 that is `docker compose up` on a shared
# network offering all of it to whoever can route to the machine. Widen it only
# when something off this machine really must reach the database, and change
# POSTGRES_PASSWORD in the same breath.
POSTGRES_USER=egma
POSTGRES_PASSWORD=egma
POSTGRES_DB=egma
POSTGRES_PORT=5433
POSTGRES_BIND=127.0.0.1

# Where the tests look for Postgres. They create and drop a database per test
# file, so this user needs permission to do that.
TEST_DATABASE_URL=postgres://egma:egma@localhost:5433/egma

# ClickHouse, which holds the traces. The published port is 8124 for the same
# reason Postgres publishes 5433 — so it does not collide with a ClickHouse
# already running on the machine. Loopback by default for the reason Postgres
# is: this credential is printed here too, and what it opens is every
# conversation your platform has recorded.
CLICKHOUSE_USER=egma
CLICKHOUSE_PASSWORD=egma
CLICKHOUSE_DB=egma
CLICKHOUSE_PORT=8124
CLICKHOUSE_BIND=127.0.0.1

# Where the tests look for ClickHouse. A database per test file here too, so
# this user needs permission to create and drop them.
TEST_CLICKHOUSE_URL=http://egma:egma@localhost:8124/egma

# The object store, which holds voice simulations' recordings — the bytes a row
# can only point at.
#
# Two families of names, and the split is deliberate: EGMA_S3_* is the store
# itself and what writes to it, and EGMA_BLOB_* further down is what the API
# holds to sign playback links with. They name one MinIO. Every entry in the
# second family has a counterpart in the first and defaults from it, so a
# deployment that changes nothing sets none of it and a deployment pointed at
# somebody else's S3 sets the EGMA_S3_* side.
#
# One credential reaches both halves here: the store is stood up with it, and
# the simulator writes with it, so the two can never disagree.
#
# **REQUIRED, both of them.** There is no default here and none in
# docker-compose.yml, and the deployment refuses to start without them rather
# than running on a pair printed in a public repository. What they open is the
# store's admin surface — rights to list, replace and delete every recording you
# hold — and the store publishes a port, because a browser has to be able to
# fetch a recording. MinIO refuses a password under eight characters.
#
# **A deployment pointed at somebody else's S3 still needs this pair.** The
# MinIO in docker-compose.yml is part of the default deployment and the
# simulator waits on the job that creates its bucket, so it is a container that
# starts whether or not your recordings go to it — and a store that starts needs
# a root credential. Give it a throwaway one: nothing of yours is in there.
EGMA_S3_ACCESS_KEY_ID=
EGMA_S3_SECRET_ACCESS_KEY=

# The bucket recordings land in, created on the deployment's first start. There
# is no reason to change it unless you are pointing the platform at a bucket
# you already have.
EGMA_S3_BUCKET=egma-recordings

# The store's second credential: the one the control plane signs playback links
# with. It can fetch one recording at a time and nothing else — it cannot write,
# cannot delete and cannot list — so a leak of it reads a recording rather than
# replacing one. That is why it is a separate pair from the write credential
# above: a recording is evidence, and evidence somebody else can overwrite is
# not evidence. The deployment creates this user on first start.
#
# **REQUIRED, both of them**, for the reason the pair above is: reading every
# recording a deployment holds is not a right this repository may hand out with
# its source.
EGMA_S3_READ_ACCESS_KEY_ID=
EGMA_S3_READ_SECRET_ACCESS_KEY=

# Which region the store's signatures carry. Both halves read it — the
# simulator signs its uploads with it and the API signs playback links with it —
# so it is set here once and never in two places. Empty is right for MinIO,
# which ignores regions entirely; a bucket on Amazon's own S3 needs its real
# region here, and the API refuses to start pointed at an amazonaws.com address
# without one rather than signing every recording for us-east-1 and having every
# single playback come back `SignatureDoesNotMatch`.
EGMA_S3_REGION=

# Where the object store is published on this machine, and to whom.
#
# The port is moved for the reason Postgres publishes 5433: so a MinIO already
# running here does not collide. Changing it means changing
# EGMA_BLOB_PUBLIC_URL below to match.
#
# **The bind is loopback by default and that is a security decision, not a
# default nobody thought about.** What answers on this port is the store's admin
# surface and its root credential, which can list, replace and delete every
# recording you hold. On 0.0.0.0 that is `docker compose up` on a shared network
# offering every recording to the room, to read and to overwrite.
#
# That credential used to have a development default printed above, in a public
# repository, which made the sentence above true on your own network too. It has
# none now — you chose it, and the deployment refuses to start until you have.
# The loopback bind stays all the same: a password is one mistake away from a
# wide port, and closing the port by default is the half that costs nothing.
#
# Open it when the browsers that need recordings are not on this machine: set
# EGMA_S3_BIND=0.0.0.0 and set EGMA_BLOB_PUBLIC_URL to the address those
# browsers use.
EGMA_S3_PORT=9000
EGMA_S3_BIND=127.0.0.1

# Where **a browser** reaches the object store — which is not where the API
# reaches it, and confusing the two is the single most common way a self-hosted
# object store breaks.
#
# A recording is played by the browser fetching it from the store directly, with
# a short-lived link the API signs. A signature covers the host it was made for:
# sign for `minio:9000` inside the compose network, fetch from a browser, and
# every recording fails with `SignatureDoesNotMatch` — an error that names
# neither address. So this is the browser's address, always.
#
# The default assumes the browser is on this machine. An Egma instance other people reach
# — at 192.168.1.10, at egma.example — has to say so here, exactly as it already
# has to in EGMA_BASE_URL, and the two are set at the same moment.
#
# **The two must agree about http: and https:.** They are one browser's two
# addresses. A page served over https: may not fetch audio over http: — every
# browser blocks it as mixed content before the request is sent — so an https:
# EGMA_BASE_URL with an http: address here plays nothing at all, and the API
# refuses to start rather than let you find that out one recording at a time.
# The other way round is fine.
#
# **What a plaintext address here costs, if you use one:** the recording itself
# and the fifteen-minute link that fetches it both cross the network readable by
# anybody who can see the traffic — a customer's call audio, and an address that
# replays it until it expires. On this machine (`localhost`) that is nobody. On
# 192.168.1.10 that is everybody on that network, so use it only where you trust
# the network, and put the store behind the same certificate as Egma when you do
# not. It is allowed rather than refused because an Egma instance on http: is already
# handing that same network the session cookie that opens every recording.
#
# Leaving it empty is allowed: the platform runs and asking for a recording
# answers with the name of this variable rather than with a player that does
# nothing.
EGMA_BLOB_PUBLIC_URL=http://localhost:9000

# The rest of what the API needs to sign one. Each defaults from its EGMA_S3_*
# counterpart above — the bucket from EGMA_S3_BUCKET, the region from
# EGMA_S3_REGION, the credential from the read-only pair — so a deployment that
# changes nothing sets none of these, and a deployment on somebody else's S3
# sets the EGMA_S3_* side once and both halves follow. Set one of these directly
# only to make the API differ from the simulator on purpose, which on one store
# is nearly always a mistake.
#
# Naming EGMA_BLOB_PUBLIC_URL is what makes the credential required, and the API
# refuses to start on half of one.
EGMA_BLOB_BUCKET=egma-recordings
EGMA_BLOB_REGION=
EGMA_BLOB_ACCESS_KEY_ID=
EGMA_BLOB_SECRET_ACCESS_KEY=

# The second bucket on the same store: where production evidence becomes
# durable before anything answers success to whoever sent it.
#
# This is a **spool**, not an archive. A conversation's evidence lands here as
# one compressed segment, Egma answers the sender, and the segment is read into
# the trace store and then deleted. What is in the bucket at any moment is what
# has not been drained yet, which on a healthy deployment is close to nothing
# and during a trace-store outage is everything that arrived while it was down.
#
# **It is a separate bucket with a separate credential, and that is the point.**
# The ingestion credential can write, read, list and delete inside
# `pending/` — a spool is not much use otherwise — so what keeps it away from
# your call recordings cannot be the operations it is allowed. It is the
# bucket: this pair is granted one prefix of one bucket and nothing in the
# recordings bucket at all. The recordings credentials are equally unable to
# touch a pending segment.
#
# The bundled MinIO holds both buckets. This release adds no second container.
# **What that store promises is worth knowing:** the volume survives a
# container being replaced, and it does not survive the loss of the host or its
# disk. Hosted Egma points this at AWS S3, which is remote from the process
# that accepts the evidence — that is the difference between "durable" and
# "durable somewhere else".
#
# Both halves are **REQUIRED for any deployment that accepts evidence**, which
# is every deployment that is not a read-only replica. There is no default here
# for the reason there is none for the recordings pair, and the refusal happens
# in the API rather than in the compose file: the API is the process that knows
# whether its role accepts evidence, and it names the variable and stops.
# `openssl rand -hex 8` and `openssl rand -base64 24` make a pair.
EGMA_S3_INGEST_ACCESS_KEY_ID=
EGMA_S3_INGEST_SECRET_ACCESS_KEY=

# The bucket the pending spool lives in, created on the deployment's first
# start beside the recordings one.
EGMA_INGEST_BUCKET=egma-ingestion

# The rest of what the API needs to reach it. Each defaults from its EGMA_S3_*
# or EGMA_INGEST_* counterpart, so a deployment that changes nothing sets none
# of these.
#
# **EGMA_INGEST_ENDPOINT is this container's address for the store, not a
# browser's**, and it is the one place in this file where those two are
# genuinely different settings pointing at one MinIO. A recording is fetched by
# a browser from EGMA_BLOB_PUBLIC_URL; a segment is uploaded by Egma itself
# from inside the deployment's own network, which is `http://minio:9000`.
# Nothing outside the deployment ever reaches this address, and nothing signs a
# link for it.
EGMA_INGEST_ENDPOINT=http://minio:9000
EGMA_INGEST_REGION=
EGMA_INGEST_ACCESS_KEY_ID=
EGMA_INGEST_SECRET_ACCESS_KEY=

# Which halves of ingestion this process serves: `all`, `ingest` or `drain`.
#
# `all` is what this deployment runs and what hosted Egma runs — one process
# accepts evidence and drains the spool. The other two are here so that
# splitting those apart on a larger deployment later is this one setting rather
# than a second image, a second protocol and a migration. Exactly one drainer
# runs per deployment in this release.
EGMA_ROLE=all

# Where accepted evidence waits between being staged and being durable.
#
# It is a directory on a Docker named volume, `api-ingestion`, and it holds
# evidence Egma has taken responsibility for and has not made durable yet. A
# restart reads it back; `docker compose down -v` deletes it, and doing that
# with a backlog in it throws away evidence Egma answered success to.
EGMA_INGESTION_LOG_DIR=/var/lib/egma/ingestion

# What that staging area holds before Egma starts refusing new evidence.
#
# Both bind, because records are not all one size: a bound in bytes alone is
# reached after ten conversations on one deployment and ten million on another.
# Past either, the door answers a **retryable** failure and nothing already
# staged is discarded to make room — an exporter that is told to retry keeps
# its evidence, and an Egma that quietly dropped an older record to look
# healthy would not.
#
# 512 MiB and 200,000 records are documented starting values chosen to sit
# inside an ordinary root disk, not a proven capacity. On the bundled
# deployment this volume shares the disk with everything else.
EGMA_INGESTION_LOG_MAX_BYTES=536870912
EGMA_INGESTION_LOG_MAX_RECORDS=200000

# How long the oldest staged record waits for company before its segment is
# sealed and uploaded.
#
# A low-volume deployment lives on this number: one conversation's spans must
# not wait for a batch that will never fill. It is a starting value inside the
# product's two-second visibility target rather than a constant — raising it
# trades visibility for fewer, larger objects.
EGMA_INGESTION_FLUSH_MILLISECONDS=500

# And how large one segment gets before it seals regardless of the clock. The
# byte bound counts uncompressed evidence and sits under the trace store's own
# insert bound, so one segment is at most one or two inserts.
EGMA_INGESTION_SEGMENT_MAX_BYTES=8388608
EGMA_INGESTION_SEGMENT_MAX_RECORDS=5000

# How long a request waits for the object store before Egma answers it
# retryably. Past this the sender is told to try again and the staged evidence
# stays eligible for upload, so a slow store costs a retry rather than a false
# success. It is never unbounded: a door that holds a request open forever is a
# door that has stopped answering.
EGMA_INGESTION_REQUEST_TIMEOUT_MILLISECONDS=10000

# How often the whole pending prefix is listed.
#
# That listing is the recovery authority, and it runs once at startup as well —
# handing a freshly uploaded segment straight to the drainer is a speed hint,
# and a hint that is lost or delivered twice must not be able to lose evidence.
EGMA_INGESTION_SCAN_INTERVAL_MILLISECONDS=30000

# What session cookies are signed with. **REQUIRED** — there is no default in
# the compose file any more, and the deployment refuses to start without one
# rather than signing your sessions with a secret published in this repository.
# `openssl rand -base64 32` is a fine way to make one.
EGMA_AUTH_SECRET=

# What connection credentials and this platform's own settings are sealed with
# before they are stored: 32 random bytes written as 64 hex characters.
# `openssl rand -hex 32` makes one.
#
# **REQUIRED**, and this is the one that most needed to be. It used to have a
# development default in the compose file, which meant a deployment could seal
# every stored connection and carrier credential with a key printed in a public repository and
# nothing anywhere would say so. Back it up alongside the database — the stored
# credentials and settings are unrecoverable without it, and a backup of one
# without the other is half a backup.
EGMA_ENCRYPTION_KEY=

# Where a browser reaches this instance. **REQUIRED**, and `egma self-host up`
# sets it to the address it prints, so only a deployment driven by plain
# `docker compose` has to state it here. The pages and the API answer on one
# origin, so this is both of them, and it is always your own — nothing about
# logging in reaches a domain Egma runs.
#
# It must be the whole address people use and nothing more: scheme, host and
# port. An agent repository reads this instance's identity here before it sends
# anything, and it will not follow an instance to an address the developer did
# not give it — so an instance that others reach at 192.168.1.10 or at
# egma.example must say exactly that, or their first command refuses and says
# which of the two addresses to fix.
#
# **This line is left empty on purpose, and it is the one value in this file
# where a helpful-looking default would be the most expensive.** A copied
# `http://localhost:3101` is correct on a laptop and wrong on every deployment
# anybody else reaches — and wrong in the quiet way, because the platform starts
# and answers perfectly while every agent repository is refused at a directory's
# distance from the cause. `http://localhost:3101` is what a laptop writes here.
#
# Changed in the self-hosted release: a value carrying a path, query, fragment
# or credentials is now refused at startup instead of being trimmed. Serving
# Egma under a subpath was never supported; if yours is set that way, drop
# everything after the port. The startup message names the part to remove.
EGMA_BASE_URL=

# One organization on this deployment, and the first person to sign up claims
# it and becomes its admin. Everyone after them arrives by invitation. Turn it
# off only for a deployment that holds many customers.
EGMA_SINGLE_ORGANIZATION=true

# Whether x-forwarded-proto and x-forwarded-host may be believed. Turn this on
# only when something you run is in front, because otherwise any client can
# claim any origin.
EGMA_TRUST_PROXY=false

# How many credentialed requests one organization may make per minute. The
# budget belongs to the organization rather than to a key, so rotating a key
# does not reset it and ten deployments sharing an account do not get ten
# budgets.
EGMA_RATE_LIMIT_PER_MINUTE=600

# Mail, which is optional and unset by default. With none, an invitation hands
# its link back to whoever sent it and signup asks for no verification; setting
# these turns both around at once. It is never a prerequisite for anything,
# including adding a second person.
EGMA_SMTP_URL=
EGMA_MAIL_FROM=

# Where the API and the web application are published on this machine. Move
# them when something else already has these ports, or to stand two Egma instances
# platforms side by side on one machine — each keeps its own instance identity,
# so an agent repository bound to one can never be answered by the other. Set
# EGMA_BASE_URL above to match whichever address people really reach.
EGMA_API_PORT=3100
EGMA_WEB_PORT=3101

# Where the web application proxies the API's paths. Read when the web
# application is built, not when it starts. This is inside the compose network,
# so it does not move when the published ports above do.
EGMA_API_ORIGIN=http://api:3100

# The simulator, the container that conducts simulations. It claims its work
# rather than being sent it, so it publishes no port and needs no inbound
# networking. Everything below has a working default, and the simulator
# refuses to start on anything it cannot use, naming the variable when it does.

# Where it claims, heartbeats and reports. Required — a simulator with no
# control plane is nothing — and compose supplies the API's address on its own
# network. Point it elsewhere to run a simulator beside somebody else's Egma instance.
EGMA_SIMULATOR_CONTROL_PLANE_URL=http://api:3100

# What the simulator shows the API to be allowed to claim work, sent as
# `Authorization: Bearer`. One value, read by both containers, and the API
# checks it on every claim — the answers carry your customers' live provider
# credentials, so this door is never open.
#
# **REQUIRED.** No default in the compose file: port 3100 is published on the
# host, and whoever holds this token is handed those credentials, so a token
# every reader of this repository knows is a door standing open. It must start
# with egma_st_ so scanners recognise a leak;
# `echo "egma_st_$(openssl rand -hex 32)"` makes one.
EGMA_SIMULATOR_SERVICE_TOKEN=

# How many simulations this simulator conducts at once. Leave this empty for
# the simulator's own default of two. It claims only what it has room for, so
# more work than this queues instead of overloading.
#
# It is also the ceiling on concurrent phone calls, because a voice simulation
# holds a channel on the deployment's carrier trunk for as long as it lasts.
# Raise it only as far as that trunk really goes: past there the carrier starts
# refusing calls, and a refused call is a failed simulation rather than a
# queued one.
EGMA_SIMULATOR_CAPACITY=

# **Which providers and models this simulator uses is not set here.** The pinned
# persona version supplies one complete LLM, STT and TTS selection. The API adds
# only the current keys for those selected providers when this simulator claims
# the work. There is no container fallback for a missing model, voice or key.

# --- Phone calls -------------------------------------------------------------
# Only for a simulation whose connection names a phone number. Nothing below is
# read until one does, and a simulator that never dials needs none of it.
#
# **The carrier trunk is live platform configuration and is not here.** The
# LiveKit bridge remains deployment configuration below. An administrator creates the Twilio
# trunk and one credential per developer or production. Set those four runtime
# values under "What this platform is configured with" further down, or let
# `egma self-host setup` copy them into the platform's own store. They reach every simulator on the
# work order it claims, so the carrier work you did once is done once, and a
# second simulator on another machine needs nothing copied to it.
#
# What is left here is the media server this container talks to. It is a
# third-party binary that reads its own key and secret when it is *created*, so
# it can never come from the platform's store. The same three variables point at
# a self-hosted LiveKit and at LiveKit Cloud — only the URL differs. Left empty,
# they are filled in from the LiveKit beside the simulator and the EGMA_LIVEKIT_*
# pair further down; set them here only to point at a LiveKit you run elsewhere.
EGMA_SIMULATOR_LIVEKIT_URL=
EGMA_SIMULATOR_LIVEKIT_API_KEY=
EGMA_SIMULATOR_LIVEKIT_API_SECRET=

# --- The phone stack ----------------------------------------------------------
# The LiveKit server, its SIP gateway and their Redis. They are part of the
# default deployment: `egma self-host up` and a plain `docker compose up` both
# start them, and there is no overlay to ask for by name any more.
#
# Read the README before you expose the gateway. It is the one container in Egma
# that has to be reachable from your carrier for the audio of a call, which is
# routine on a server and wrong on a laptop. LiveKit Cloud instead is one
# variable — point EGMA_SIMULATOR_LIVEKIT_URL at it and leave these alone.

# What the three containers authenticate each other with, and what the simulator
# is given when EGMA_SIMULATOR_LIVEKIT_API_KEY and _SECRET above are left empty.
#
# Leave both empty. `egma self-host up` generates a random pair for this
# workspace, writes it to .egma-platform/platform.env, and hands the same one to
# the media server, the simulator and the SIP gateway. It is a password between
# Egma's own parts, like the Postgres password: you never choose it and never
# type it, and a pair that already exists is left alone so that preparing the
# workspace again does not lock out a running deployment.
#
# **REQUIRED**, and there is deliberately no default here and none in
# docker-compose.yml. There used to be one, written into a public repository,
# which nothing ever replaced — so any deployment that widened
# EGMA_LIVEKIT_BIND was accepting anyone who had read that repository. Empty is
# no longer quietly accepted either: `docker compose up` with neither of these
# set refuses and names them, rather than starting a media server with no
# password and a simulator that waits on it for ever. Set these two by hand
# only if you drive the compose file without the Egma CLI, and then treat them
# as secrets.
EGMA_LIVEKIT_API_KEY=
EGMA_LIVEKIT_API_SECRET=

# Where the LiveKit server's own ports are published. Loopback by default: the
# simulator reaches it across the compose network, so this is for a person at
# this machine and for nothing else.
EGMA_LIVEKIT_BIND=127.0.0.1

# What the server tells clients to send media to. Empty is right whenever its
# clients are the containers beside it, which is every ordinary deployment. Set
# it to this machine's LAN address — with EGMA_LIVEKIT_BIND=0.0.0.0 — to reach
# the server from outside the compose network, which is what running the live
# phone test needs on Docker Desktop.
EGMA_LIVEKIT_ADVERTISE_IP=

# The gateway's SIP port, and the range it hands out for call audio. The range
# is narrow on purpose — about two ports per concurrent call — because it is
# published to the internet and a range published is a range to justify. Widen
# both ends together if you raise the simulator's capacity, and widen your
# firewall by exactly as much.
EGMA_LIVEKIT_SIP_PORT=5060
EGMA_LIVEKIT_SIP_RTP_PORT_START=10000
EGMA_LIVEKIT_SIP_RTP_PORT_END=10020

# What address the gateway writes into the SDP your carrier reads. Leave the
# first as it is and the gateway asks a STUN server what the world sees. Set
# the second when you already know the address — an elastic IP, a 1:1 NAT —
# and it is used exactly as given, which is the configuration the README
# recommends for a server.
EGMA_LIVEKIT_SIP_USE_EXTERNAL_IP=true
EGMA_LIVEKIT_SIP_EXTERNAL_IP=

# How loud the two LiveKit containers are: debug, info, warn, error.
EGMA_LIVEKIT_LOG_LEVEL=info

# How this simulator names itself when claiming; it is stamped on the row it
# claims. Defaults to its host name and process id, which under compose is the
# container — enough to tell two simulators apart.
EGMA_SIMULATOR_CLAIMANT=

# How often each running simulation beats, and how long one claim request may
# hang while the queue is empty. Both in seconds, and both are for a slow link
# rather than for tuning.
EGMA_SIMULATOR_HEARTBEAT_SECONDS=5
EGMA_SIMULATOR_CLAIM_WAIT_SECONDS=30

# How long one report keeps being resent before the write-ahead log on disk
# becomes its only record. Seconds.
EGMA_SIMULATOR_REPORT_DEADLINE_SECONDS=120

# Where reports are written before they are sent. This one is the exception to
# the line at the top of this file: under compose it is fixed to a path inside
# the `simulator-data` volume and is not read from here, because a value in
# .env that moved it off that volume would quietly cost you every report that
# was in flight the next time a container was replaced. To move it under
# compose, use a compose override. The value below is what a bare
# `egma-simulator` process uses, relative to wherever it was started.
EGMA_SIMULATOR_WAL_DIR=.egma-simulator/wal

# Where a simulator sends its recordings, and what it authenticates with.
# Naming an endpoint is the whole of what selects object storage; naming none
# keeps recordings in the directory below, which is what a bare
# `egma-simulator` process does and what the test suite runs on — contributing
# to Egma costs you no object store. The region is only ever signed with; MinIO
# ignores it.
#
# **All five are blank on purpose.** Under compose the bucket and the two
# credential halves are filled in from the EGMA_S3_* entries at the top of this
# file; the endpoint is written into the compose file as the `minio` container's
# own address, and the region falls back to us-east-1 in the simulator itself.
# A value set here wins over all of that, so it would point this deployment's
# simulator away from the store this deployment actually runs. Set them only to
# use somebody else's S3, and then set all five: a bucket named here while the
# one at the top of the file is left alone is a simulator writing to a bucket
# nothing created.
EGMA_SIMULATOR_S3_ENDPOINT=
EGMA_SIMULATOR_S3_BUCKET=
EGMA_SIMULATOR_S3_REGION=
EGMA_SIMULATOR_S3_ACCESS_KEY_ID=
EGMA_SIMULATOR_S3_SECRET_ACCESS_KEY=

# Where recordings land when no endpoint above names an object store. Nothing
# under compose reads it — that deployment runs object storage and the
# simulator writes no audio to its own filesystem — so this is the path a bare
# `egma-simulator` process uses, relative to wherever it was started.
EGMA_SIMULATOR_BLOB_DIR=.egma-simulator/blobs

# The usual levels: CRITICAL, ERROR, WARNING, INFO, DEBUG.
EGMA_SIMULATOR_LOG_LEVEL=INFO

# Which port the workbench publishes, for the dev-only overlay that starts one.
# `docker compose up` starts no workbench, so this is unused until you ask for
# it; see the README. It is published to 127.0.0.1 and not to the network,
# whatever port you pick: the workbench authenticates nobody.
EGMA_WORKBENCH_PORT=8085

# --- Model provider credentials -----------------------------------------------
# Persona and grader versions choose providers and models. This file supplies
# only the credentials needed to call those providers. A self-host writes one
# current key per provider here. A fresh database needs no key copy or sync.
EGMA_OPENAI_API_KEY=
EGMA_DEEPGRAM_API_KEY=
EGMA_CARTESIA_API_KEY=

# Egma Cloud leaves the three direct values empty and names one AWS Secrets
# Manager object instead. The API reads its current value for each claimed
# simulation. The grader reads it only when a claimed job includes a
# model-judged grader. Rotation therefore affects the next model-using work
# without a container restart. Ordinary self-hosted deployments leave these
# empty.
EGMA_PROVIDER_CREDENTIALS_SECRET_ID=
EGMA_PROVIDER_CREDENTIALS_REGION=

# --- What this platform is configured with ------------------------------------
# The phone route is live platform configuration and remains in Postgres. Model
# choices and provider keys do not.

# Who owns the carrier route after startup. `platform` is the default: the
# phone values below seed a missing route, but they do not replace a complete
# route in the platform store. Use `environment` when deployment secrets are
# the source of truth. In that mode every startup replaces the stored carrier
# route with the complete phone bundle below; leaving all phone values empty
# removes the stored route. This choice does not depend on whether the platform
# serves one organization or several. The platform store contains no model or
# provider-key settings.
EGMA_CARRIER_SETTINGS_SOURCE=platform

# How a phone simulation reaches the telephone network: which bridge places it,
# and the trunk the carrier authenticates. Keep one Twilio trunk and credential list,
# but give each developer and production its own SIP username/password in that
# list. A credential-authenticated route supplies all four phone values. A
# source-IP-authenticated carrier supplies only the trunk address and source
# number. A fresh database copies either complete route into the platform store
# without reading or changing Twilio. The media server's own key and secret are
# *not* here — they belong to a container that reads them when it is created,
# so they stay with EGMA_LIVEKIT_API_KEY and EGMA_LIVEKIT_API_SECRET above.
EGMA_PHONE_TRUNK_ADDRESS=
EGMA_PHONE_SOURCE_NUMBER=
EGMA_PHONE_TRUNK_USERNAME=
EGMA_PHONE_TRUNK_PASSWORD=

# --- The grader ------------------------------------------------------------
# The service that judges finished conversations. It claims its work, so it
# publishes no port and needs no inbound networking.
#
# Each judged grader version owns its model selection. The grader reads the
# current deployment credential bundle once for each claimed grading job. It
# has no copied model or credential fallback.

# How this copy of the grader names itself when claiming; it is stamped on the
# job it claims. Defaults to its host name and process id, which under compose
# is the container — enough to tell two copies apart.
EGMA_GRADER_CLAIMANT=

# How many conversations one copy judges at once. A copy claims only what it
# has room for, so a burst degrades to a queue rather than to overload. More
# throughput is more copies: `docker compose up --scale grader=3`.
EGMA_GRADER_CAPACITY=4

# How often a copy says it is still alive while it holds a conversation, and
# how long its claim survives its silence. Both in seconds. A copy replaced
# mid-judgment loses the job to whichever copy asks after the lease runs out,
# which is why the heartbeat must stay well under it.
EGMA_GRADER_HEARTBEAT_SECONDS=15
EGMA_GRADER_LEASE_SECONDS=120

# How often a copy asks anyway. This is **not** how work arrives: a conversation
# ending wakes the service on the transaction that ended it, and nothing a
# verdict waits for is on a timer. This is the backstop for a notification
# raised while every copy happened to be restarting. Seconds.
EGMA_GRADER_SWEEP_SECONDS=30

# How long a production conversation must be quiet before it is judged without
# ever having been closed. A well-behaved exporter closes the span the whole
# conversation happened inside, Egma is woken by it, and this decides nothing:
# it is here for the exporter that never closes one, where the event to wait for
# is the absence of events. Seconds.
EGMA_GRADER_TRACE_IDLE_SECONDS=300

# The usual levels: DEBUG, INFO, WARN, ERROR.
EGMA_GRADER_LOG_LEVEL=INFO

# ── Egma platform telemetry ─────────────────────────────────────────────────
#
# One flag, and it defaults to off: a default deployment sends nothing
# anywhere, imports nothing, and phones nothing home. This makes egma's own
# containers observable — it is **not** the trace store. What customers'
# agents and simulations send through the OTLP door is their data, in this
# deployment's ClickHouse. What this flag turns on is the platform reporting
# on its own processes through the deployment telemetry pipeline.

# The whole decision, and the only switch. Anything but `on` — including
# unset, which is the default — means off, whatever else below is set. On
# means everything reports at once: spans to the endpoint, crashes to the
# key. There are no smaller switches inside it, so `on` requires both values
# below — the api and grader refuse to start without them, naming what is
# missing, rather than run with telemetry quietly half-off.
EGMA_TELEMETRY=

# The configured OTLP destination for the api's and grader's own spans. This
# is normally a deployment telemetry collector beside egma. The collector's
# exporter is the adapter to the span backend: PostHog today, and a different
# observability backend later without changing the api or grader tracing.
# A destination that wants credentials gets them the standard way: the OTEL_*
# variables are honoured and win when both are set, so a collector on the same
# network keeps backend tokens out of app containers.
EGMA_TELEMETRY_OTLP_ENDPOINT=

# The separate, current PostHog adapter for browser analytics and crash
# reporting: a PostHog project token (phc_…), and the PostHog address when it
# is not PostHog US Cloud. Uncaught exceptions and unhandled rejections are
# captured with their stacks. Ordinary api and grader logs stay as JSON on
# standard output; the deployment collector reads that one copy with filelog.
EGMA_POSTHOG_KEY=
EGMA_POSTHOG_HOST=
