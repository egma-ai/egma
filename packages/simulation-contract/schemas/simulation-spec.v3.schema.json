{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egma:simulation-contract:spec:v3",
  "title": "Simulation spec (v3)",
  "description": "The only simulation work-order contract. The connection kind selects the simulator adapter, the access variant selects its authority and configuration, and the agent platform records provenance only. The pinned persona version supplies one complete LLM, STT, and TTS selection. The control plane resolves current direct provider credentials when it prepares the claim. The simulator has no platform or container fallback for model or voice choices.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "simulation_id",
    "modality",
    "connection",
    "persona",
    "scenario",
    "limits",
    "models"
  ],
  "properties": {
    "contract_version": {
      "description": "The one spec version this simulator implements.",
      "type": "integer",
      "const": 3
    },
    "simulation_id": {
      "description": "The simulation this spec conducts. Opaque to the simulator.",
      "type": "string",
      "minLength": 1
    },
    "modality": {
      "description": "Chat exercises the agent harness. Voice adds the speech stack.",
      "type": "string",
      "enum": ["chat", "voice"]
    },
    "connection": {
      "description": "How the simulator reaches the agent under test. Connection kind selects the adapter, access variant selects the authority and configuration inside it, and agent platform records what runs the target without selecting code.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_platform",
        "connection_kind",
        "access_variant",
        "config",
        "credentials"
      ],
      "properties": {
        "agent_platform": {
          "description": "The product or framework that runs or exposes the agent, or null when unknown. It records provenance and never selects simulator code.",
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "connection_kind": {
          "description": "The direct path the simulator selects. It is an open vocabulary so a simulator without the named adapter can refuse it clearly at runtime.",
          "type": "string",
          "minLength": 1
        },
        "access_variant": {
          "description": "The configuration and authority used inside the selected connection kind. It is explicit and is never inferred from config keys.",
          "type": "string",
          "minLength": 1
        },
        "config": {
          "description": "The non-secret reach configuration, exactly as stored on the connection. Its keys belong to the selected access variant; this schema does not know them.",
          "type": "object"
        },
        "credentials": {
          "description": "The resolved secret material for this connection, unsealed by the control plane for exactly this hand-off, or null where the access variant takes no customer secret. The simulator holds it in memory, hands it only to the adapter, and never logs, persists, or reports it.",
          "oneOf": [{ "type": "object" }, { "type": "null" }]
        }
      }
    },
    "persona": {
      "description": "Who talks on the human side of the transcript.",
      "type": "object",
      "additionalProperties": false,
      "required": ["traits"],
      "properties": {
        "traits": {
          "description": "Authored behavior only. Technical voice settings live only in models.tts.",
          "type": "object",
          "additionalProperties": false,
          "required": ["personality", "language"],
          "properties": {
            "personality": {
              "type": "string",
              "minLength": 1
            },
            "language": {
              "type": "string",
              "minLength": 1
            },
            "manner": {
              "type": "string",
              "minLength": 1
            },
            "patience": {
              "type": "string",
              "minLength": 1
            },
            "accent": {
              "type": "string",
              "minLength": 1
            },
            "backgroundNoise": {
              "type": "string",
              "minLength": 1
            },
            "underFriction": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "scenario": {
      "description": "What the persona wants in this test.",
      "type": "object",
      "additionalProperties": false,
      "required": ["instructions"],
      "properties": {
        "instructions": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limits": {
      "description": "The walls around one simulation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["max_duration_seconds", "max_turns"],
      "properties": {
        "max_duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "mock_tools": {
      "description": "Resolved mock-tool answers for this simulation.",
      "type": "array",
      "items": { "$ref": "#/$defs/mock_tool" }
    },
    "platform": {
      "description": "Deployment carrier data. It contains the SIP trunk only. The media backend remains deployment configuration.",
      "type": "object",
      "additionalProperties": false,
      "required": ["carrier"],
      "properties": {
        "carrier": { "$ref": "#/$defs/platform_carrier" }
      }
    },
    "models": {
      "$ref": "#/$defs/models"
    }
  },
  "$defs": {
    "platform_carrier": {
      "description": "The complete carrier route used for a phone simulation. Address and number are always present. SIP username and password are either both absent for source-IP authentication or both present for credential authentication.",
      "type": "object",
      "additionalProperties": false,
      "required": ["trunk_address", "trunk_number"],
      "dependentRequired": {
        "trunk_username": ["trunk_password"],
        "trunk_password": ["trunk_username"]
      },
      "properties": {
        "trunk_address": {
          "type": "string",
          "minLength": 1
        },
        "trunk_number": {
          "type": "string",
          "minLength": 1
        },
        "trunk_username": {
          "type": "string",
          "minLength": 1
        },
        "trunk_password": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "models": {
      "description": "The complete model selection from the pinned persona version, with direct credentials resolved for this claim.",
      "type": "object",
      "additionalProperties": false,
      "required": ["llm", "stt", "tts"],
      "properties": {
        "llm": { "$ref": "#/$defs/llm_selection" },
        "stt": { "$ref": "#/$defs/stt_selection" },
        "tts": { "$ref": "#/$defs/tts_selection" }
      }
    },
    "llm_selection": {
      "description": "The persona brain. This release has one proved direct LLM adapter.",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "key"],
      "properties": {
        "provider": { "type": "string", "const": "openai" },
        "model": { "type": "string", "const": "gpt-4o-mini" },
        "key": { "type": "string", "minLength": 1 }
      }
    },
    "stt_selection": {
      "description": "The persona ears. The provider and model form one closed pair. OpenAI always uses the realtime adapter.",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["deepgram", "openai"]
        },
        "model": { "type": "string" },
        "key": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "provider": { "const": "deepgram" } },
            "required": ["provider"]
          },
          "then": {
            "properties": { "model": { "const": "nova-3-general" } }
          },
          "else": {
            "properties": { "model": { "const": "gpt-live-transcribe" } }
          }
        }
      ]
    },
    "tts_selection": {
      "description": "The persona mouth. Voice and speed live with the provider and model that interpret them.",
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "voice_id", "speed"],
      "properties": {
        "provider": {
          "type": "string",
          "enum": ["cartesia", "openai"]
        },
        "model": { "type": "string" },
        "voice_id": { "type": "string", "minLength": 1 },
        "speed": { "type": "number", "minimum": 0.6, "maximum": 1.5 },
        "key": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "provider": { "const": "cartesia" } },
            "required": ["provider"]
          },
          "then": {
            "properties": { "model": { "const": "sonic-3.5" } }
          },
          "else": {
            "properties": { "model": { "const": "gpt-4o-mini-tts" } }
          }
        }
      ]
    },
    "mock_tool": {
      "description": "One mock tool name and its resolved answer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "answer", "delay_milliseconds"],
      "properties": {
        "tool_name": {
          "type": "string",
          "minLength": 1
        },
        "answer": { "$ref": "#/$defs/mock_tool_answer" },
        "delay_milliseconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      }
    },
    "mock_tool_answer": {
      "description": "A returned value or a failure, never both.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["answer"],
          "properties": {
            "answer": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["error"],
          "properties": {
            "error": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "connection": {
            "type": "object",
            "properties": {
              "connection_kind": { "const": "phone_number" }
            },
            "required": ["connection_kind"]
          }
        },
        "required": ["connection"]
      },
      "then": {
        "type": "object",
        "properties": { "platform": {} },
        "required": ["platform"]
      },
      "else": {
        "type": "object",
        "not": {
          "type": "object",
          "properties": { "platform": {} },
          "required": ["platform"]
        }
      }
    },
    {
      "if": {
        "properties": { "modality": { "const": "voice" } },
        "required": ["modality"]
      },
      "then": {
        "properties": {
          "models": {
            "type": "object",
            "properties": {
              "stt": {
                "type": "object",
                "properties": { "key": {} },
                "required": ["key"]
              },
              "tts": {
                "type": "object",
                "properties": { "key": {} },
                "required": ["key"]
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "models": {
            "type": "object",
            "properties": {
              "stt": {
                "type": "object",
                "not": {
                  "properties": { "key": {} },
                  "required": ["key"]
                }
              },
              "tts": {
                "type": "object",
                "not": {
                  "properties": { "key": {} },
                  "required": ["key"]
                }
              }
            }
          }
        }
      }
    }
  ]
}
