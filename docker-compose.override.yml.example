# Copy to docker-compose.override.yml to raise ClickHouse file-descriptor
# limits. Check the host and Docker daemon hard limits first; requesting
# more than the daemon permits can prevent container creation. Use this for
# descriptor exhaustion such as Cannot open epoll descriptor / Too many open files.
# On systemd hosts, inspect LimitNOFILE for docker.service as well as ulimit -Hn.

services:
  clickhouse:
    ulimits:
      nofile:
        soft: 262144
        hard: 262144
